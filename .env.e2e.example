# Ambiente dedicado para a bateria HTTP E2E mutante (docs/auditoria-e2e-http-2026-07-16.md).
# Copie para .env.e2e e suba a app com este env (APP_ENV=e2e) antes de rodar `php artisan e2e:run`.
# Objetivo: banco descartável e identificável + debug desligado, isolando do dev e do phpunit `testing`.

APP_ENV=e2e
APP_DEBUG=false
APP_URL=http://localhost

# Banco DESCARTÁVEL (o nome precisa conter "e2e" para passar no gate do runner).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ead2026_e2e
DB_USERNAME=sail
DB_PASSWORD=password

# Sem efeitos colaterais reais: fila síncrona, mail em array, cache/sessão isolados.
QUEUE_CONNECTION=sync
MAIL_MAILER=array
CACHE_STORE=array
SESSION_DRIVER=array

# Observabilidade off no e2e.
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
