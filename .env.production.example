# Provider-neutral production contract. Copy outside Git and replace every placeholder.
# Generate APP_KEY with: php artisan key:generate --show (in the release image).

APP_NAME="Sistema de EAD"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_GENERATED_32_BYTE_KEY
APP_BUILD_SHA=REPLACE_WITH_RELEASE_GIT_SHA
MIGRATION_MANIFEST_SHA=REPLACE_WITH_RELEASE_MIGRATION_MANIFEST_SHA256
APP_DOMAIN=pilot.example.com
APP_URL=https://pilot.example.com

# Exact reverse-proxy network and host regex. Never use a wildcard by default.
TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_HOSTS=^pilot\.example\.com$

# DB_ADMIN is host/bootstrap-only. The application receives only DB_RUNTIME_*.
DB_DATABASE=ead2026_production
DB_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DB_BOOTSTRAP_USERNAME=ead_bootstrap_once
DB_BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DB_RUNTIME_USERNAME=ead_runtime
DB_RUNTIME_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DB_MIGRATION_USERNAME=ead_migrator
DB_MIGRATION_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# Private host-managed Docker volume. Use local only when the volume is durable and backed up.
FILESYSTEM_DISK=local
MEDIA_DISK=local
PRODUCTION_STORAGE_VOLUME=ead2026-production-storage
PRODUCTION_DB_VOLUME=ead2026-production-db
PRODUCTION_CACHE_VOLUME=ead2026-production-cache

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# SMTP must be a real provider before password reset by e-mail is promised.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Sistema de EAD"

# Database queue is the default pilot contract; scheduler is always started.
QUEUE_CONNECTION=database
OPS_QUEUE_REQUIRED=false
OPS_MIGRATION_MANIFEST=release/migrations.manifest.json
OPS_OUTBOX_MAX_AGE_SECONDS=300
OPS_STORAGE_MIN_FREE_BYTES=1073741824
OPS04_BACKUP_MAX_AGE_SECONDS=93600
OPS04_BACKUP_ROOT=/var/backups/ead2026
OPS04_BASE_URL=https://pilot.example.com
OPS04_SCHEDULER_REQUIRED=true
OPS04_ALERT_OWNER=REPLACE_WITH_HUMAN_OWNER
OPS04_ALERT_CHANNEL=stdout-cron
OPS04_ALERT_EMAIL_TO=
OPS04_ALERT_EMAIL_FROM=no-reply@example.com
OPS04_ALERT_TIMEOUT_SECONDS=10
OPS04_ALERT_DEDUP_SECONDS=300
OPS04_ALERT_STATE_DIR=/var/lib/ead2026/ops-alerts
OPS04_EXPECTED_RC_SHA=REPLACE_WITH_RELEASE_GIT_SHA
OPS04_EXPECTED_COMPOSE_PROJECT=ead2026-production
OPS04_EXPECTED_DB_DATABASE=ead2026_production
OPS04_EXPECTED_STORAGE_VOLUME=ead2026-production-storage
OPS04_BACKUP_MANIFEST_KEY=REPLACE_WITH_BACKUP_MANIFEST_SIGNING_KEY
OPS04_REMOTE_BACKUP_DESTINATION=REPLACE_WITH_REMOTE_DESTINATION
OPS04_REMOTE_BACKUP_CREDENTIAL=REPLACE_WITH_REMOTE_BACKUP_CREDENTIAL
OPS04_REMOTE_BACKUP_ADAPTER=REPLACE_WITH_REMOTE_BACKUP_ADAPTER
OPS04_REMOTE_BACKUP_VERIFY_ADAPTER=REPLACE_WITH_REMOTE_BACKUP_VERIFY_ADAPTER
OPS04_SYNTHETIC_BASE_URL=https://synthetic.pilot.example.com
OPS04_SYNTHETIC_COMPOSE_PROJECT_NAME=ead2026-e2e
OPS04_SYNTHETIC_COMPOSE_FILES=compose.yaml:compose.e2e.yaml
OPS04_SYNTHETIC_ENV_FILE=/etc/ead2026/e2e.env
OPS04_SYNTHETIC_APP_SERVICE=laravel.test

# Exact consumer origins; never use * with credentials.
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With,X-Tenant-ID
CORS_SUPPORTS_CREDENTIALS=false

# Caddy uses ACME in production. `internal` is permitted only in local rehearsal.
CADDY_TLS_DIRECTIVE=operator@example.com
HTTP_PORT=80
HTTPS_PORT=443
