# syntax=docker/dockerfile:1.7

FROM composer:2.8 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN docker-php-ext-install exif

RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --classmap-authoritative

COPY . ./

RUN composer dump-autoload \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --classmap-authoritative

FROM php:8.4-fpm-bookworm AS app

ARG APP_BUILD_SHA=unknown
ARG MIGRATION_MANIFEST_SHA=unknown

LABEL org.opencontainers.image.title="Sistema de EAD API" \
    org.opencontainers.image.revision="$APP_BUILD_SHA" \
    org.opencontainers.image.migrations.manifest.sha256="$MIGRATION_MANIFEST_SHA"

ENV APP_BUILD_SHA="$APP_BUILD_SHA" \
    APP_RUNTIME_IMAGE="production"

WORKDIR /var/www/html

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype6-dev \
        libcurl4-openssl-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libxml2-dev \
        libonig-dev \
        libpng-dev \
        libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath curl exif gd intl mbstring pdo_mysql pcntl xml zip \
    && apt-get purge -y --auto-remove libcurl4-openssl-dev libfreetype6-dev libicu-dev libjpeg62-turbo-dev libxml2-dev libonig-dev libpng-dev libzip-dev \
    && apt-get update \
    && apt-get install -y --no-install-recommends libcurl4 libfreetype6 libicu72 libjpeg62-turbo libonig5 libpng16-16 libxml2 libzip4 zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vendor /app/vendor ./vendor
COPY . .

RUN rm -f config/scribe.php \
    && php artisan package:discover --ansi \
    && php artisan ops:migrate --write-manifest --manifest=release/migrations.manifest.json --no-interaction \
    && mkdir -p storage/app/private storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && find storage bootstrap/cache -type d -exec chmod 0700 {} \; \
    && find storage bootstrap/cache -type f -exec chmod 0600 {} \; \
    && chmod 0555 artisan

USER www-data

EXPOSE 9000

CMD ["php-fpm", "-F"]

FROM caddy:2.9-alpine AS web

ARG APP_BUILD_SHA=unknown
ARG MIGRATION_MANIFEST_SHA=unknown

LABEL org.opencontainers.image.title="Sistema de EAD API web" \
    org.opencontainers.image.revision="$APP_BUILD_SHA" \
    org.opencontainers.image.migrations.manifest.sha256="$MIGRATION_MANIFEST_SHA"

COPY --from=app /var/www/html/public /srv/public
COPY docker/caddy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
