{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "orchestrator": {
            "model": "openai/gpt-5.4",
            "variant": "medium"
        },
        "oracle": {
            "model": "openai/gpt-5.5",
            "variant": "xhigh"
        }
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}
